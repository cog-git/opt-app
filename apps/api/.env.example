# OPT API environment
# Postgres connection string (required to actually run the API against a DB)
DATABASE_URL=postgres://opt:opt@localhost:5432/opt

# Secret used to sign JWTs — set a long random value in real environments
JWT_SECRET=change-me-in-production

# Allowed browser origin for CORS (single origin, NOT a wildcard)
CORS_ORIGIN=http://localhost:5173

# Port the Fastify server listens on
PORT=4000

# Base URL of the web app — used to build the "set up your login" link sent
# in the new-organisation invite email.
APP_URL=http://localhost:5173

# SMTP settings for sending the invite email. If SMTP_HOST is unset, the API
# logs the invite link instead of sending (handy for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OPT Systems <info@optsystemsltd.com>
