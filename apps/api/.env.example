# OPT API environment
# Postgres connection string (required to actually run the API against a DB)
DATABASE_URL=postgres://opt:opt@localhost:5432/opt

# Secret used to sign JWTs — set a long random value in real environments
JWT_SECRET=change-me-in-production

# Allowed browser origin for CORS (single origin, NOT a wildcard)
CORS_ORIGIN=http://localhost:5173

# Port the Fastify server listens on
PORT=4000
